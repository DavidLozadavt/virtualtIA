py", "source_location": "L95"}, {"id": "tests_test_intent_priority_rationale_121", "label": "La conversaci\u00f3n entera del informe, turno por turno.      Ninguno de los cuatr", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L121"}, {"id": "tests_test_intent_priority_rationale_155", "label": "Con la reserva abierta y la hora pedida, \"no quiero agendar\" la termina.", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L155"}, {"id": "tests_test_intent_priority_rationale_170", "label": "No quiero agendar\" a secas no pide nada nuevo, pero cierra lo abierto.", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L170"}, {"id": "tests_test_intent_priority_rationale_188", "label": "Un negocio en foco viene de haberlo mostrado, no de haberlo elegido.      Con", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L188"}, {"id": "tests_test_intent_priority_rationale_217", "label": "Estado: se pidi\u00f3 la hora. El usuario pregunta otra cosa.      Ni se lee como h", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L217"}, {"id": "tests_test_intent_priority_rationale_237", "label": "\"\u00bfTienen citas ma\u00f1ana?\" consulta la agenda; no compromete el d\u00eda.      Recoger", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L237"}, {"id": "tests_test_intent_priority_rationale_253", "label": "No, mejor a las 10\" niega el valor, no el objetivo: la reserva sigue.", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L253"}, {"id": "tests_test_intent_priority_rationale_268", "label": "antes de eso\" ordena el turno; no es nada que buscar en el cat\u00e1logo.", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L268"}, {"id": "tests_test_intent_priority_rationale_279", "label": "\"\u00bfEs el \u00fanico?\" devuelve el mismo negocio. Eso no es un hallazgo nuevo.      V", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L279"}, {"id": "tests_test_intent_priority_rationale_313", "label": "Buscar por un servicio y agendar despu\u00e9s es UNA conversaci\u00f3n.      El usuario", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L313"}, {"id": "tests_test_intent_priority_rationale_328", "label": "Tenerlo en memoria no es querer reservarlo: sigue siendo un criterio.", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L328"}, {"id": "tests_test_intent_priority_rationale_338", "label": "Si al agendar pide otro servicio, \u00e9se es el que vale.", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L338"}, {"id": "tests_test_intent_priority_rationale_353", "label": "\"\u00bfEs el \u00fanico?\" pregunta si la lista est\u00e1 completa.      No nombra nada nuevo,", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L353"}, {"id": "tests_test_intent_priority_rationale_368", "label": "Primero quiero saber\u2026\" dice en qu\u00e9 orden, no \"el primero de la lista\".", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L368"}, {"id": "tests_test_intent_priority_rationale_374", "label": "El atajo del router le\u00eda el markdown del asistente para saber qu\u00e9 se pidi\u00f3.", "file_type": "rationale", "source_file": "tests/test_intent_priority.py", "source_location": "L374"}], "edges": [{"source": "c_xampp_htdocs_vt_projects_virtualtia_tests_test_intent_priority_py", "target": "os", "relation": "imports", "context": "import", "confidence": "EXTRACTED", "source_file": "tests/test_intent_priority.py", "source_location": "L20", "weight": 1.0}, {"source"