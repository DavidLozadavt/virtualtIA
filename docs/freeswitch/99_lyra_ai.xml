<!--
  Dialplan público Lyra — record-loop (stock, sin mod_audio_stream).
  Reemplaza la versión "solo saludo + sleep". Toda la conversación la maneja
  lyra_call.lua (grabación de llamada completa + turnos record→STT→respuesta).

  Ubicación en el contenedor: /etc/freeswitch/dialplan/public/99_lyra_ai.xml
  El script:                  /usr/share/freeswitch/scripts/lyra_call.lua
-->
<include>
  <extension name="lyra_ai_inbound">
    <condition field="destination_number" expression="^(\d+)$">
      <action application="lua" data="lyra_call.lua"/>
    </condition>
  </extension>
</include>
