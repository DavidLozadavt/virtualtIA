<!--
  Template: Dialplan llamadas entrantes Entel → Lyra IA (sin Twilio)

  Copiar/adaptar en: /etc/freeswitch/dialplan/public/99_lyra_ai.xml

  Placeholders:
    IA_HOST          — IP/host del VPS Lyra (solo red interna/VPN recomendado)
    IA_PORT          — puerto FastAPI (default 8000)
    IA_WS_SCHEME     — ws o wss (usar wss detrás de reverse proxy TLS)

  Requiere módulos:
    - mod_curl (o mod_httapi) para POST /freeswitch/inbound-call
    - mod_audio_stream para WebSocket /freeswitch/audio
-->
<include>
  <extension name="lyra_ai_inbound">
    <condition field="destination_number" expression="^(\d+)$">
      <!-- 1. Contestar -->
      <action application="answer"/>
      <action application="sleep" data="500"/>

      <!-- 2. Identificadores de llamada -->
      <action application="set" data="call_uuid=${uuid}"/>
      <action application="set" data="caller_number=${caller_id_number}"/>
      <action application="set" data="destination_number=${destination_number}"/>

      <!-- 3. Notificar a Lyra (respuesta liviana: audio_url, NO base64) -->
      <action application="curl" data="http://IA_HOST:IA_PORT/freeswitch/inbound-call post application/json {&quot;source&quot;:&quot;entel&quot;,&quot;call_uuid&quot;:&quot;${call_uuid}&quot;,&quot;caller_number&quot;:&quot;${caller_number}&quot;,&quot;destination_number&quot;:&quot;${destination_number}&quot;}"/>

      <!-- 4. Reproducir saludo desde audio_url (WAV 8kHz) -->
      <!-- Opción A: Lua parsea ${curl_response_data} → set lyra_audio_url → playback -->
      <!-- Opción B: ESL/script externo que lee JSON y ejecuta playback ${audio_url} -->
      <!-- Ejemplo si ya tienes la URL en variable: -->
      <!-- <action application="playback" data="${lyra_audio_url}"/> -->

      <!-- 5. Stream de audio hacia Lyra (STT + conversación) -->
      <!-- Sintaxis puede variar según build mod_audio_stream; ver VPS_DEPLOY.md -->
      <action application="eval" data="${uuid_audio_stream(IA_WS_SCHEME://IA_HOST:IA_PORT/freeswitch/audio ${call_uuid} mono 8000)}"/>

      <!-- 6. Mantener llamada hasta que Lyra indique hangup (ESL) o timeout -->
      <action application="sleep" data="300000"/>
      <action application="hangup"/>
    </condition>
  </extension>
</include>
