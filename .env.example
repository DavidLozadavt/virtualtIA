# ── Lyra IA — FreeSWITCH (sin Twilio) ──
# Copiar a .env local o usar archivo externo privado en VPS (ver docker-compose).

APP_ENV=production
HOST=0.0.0.0
PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

TELEPHONY_PROVIDER=freeswitch

# Backend Laravel — solicitud telefónica
INTELLITAXI_API_BASE=https://example.com/api

# LLM / STT
LLM_PROVIDER=openrouter
OPENAI_API_KEY=replace_me
OPENAI_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=replace_me
OPENAI_WHISPER_KEY=replace_me

# TTS Lyra (edge-tts)
LYRA_TTS_VOICE=es-BO-SofiaNeural

# FreeSWITCH — WebSocket audio (mod_audio_stream)
FREESWITCH_HOST=
FREESWITCH_WS_HOST=0.0.0.0
FREESWITCH_WS_PORT=8081
FREESWITCH_AUDIO_WS_PATH=/freeswitch/audio

# FreeSWITCH — ESL (opcional)
FREESWITCH_ESL_HOST=
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=replace_me

# SIP gateway (configurar en FreeSWITCH del VPS — NO en Lyra, salvo referencia)
SIP_GATEWAY_HOST=
SIP_GATEWAY_PORT=5060
SIP_USERNAME=replace_me
SIP_PASSWORD=replace_me
SIP_DOMAIN=
SIP_TRANSPORT=udp
# DID / extensión de la línea (número que recibe llamadas)
SIP_DID_NUMBER=
SIP_EXTENSION=

# VAD — detección fin de frase
FS_VAD_SILENCE_RMS=400
FS_VAD_SILENCE_FRAMES=25
FS_VAD_MIN_SPEECH_FRAMES=8
FS_MAX_UTTERANCE_SEC=12.0
FS_SPEECH_TIMEOUT_SHORT=1.5
FS_SPEECH_TIMEOUT_LONG=auto

# Geocoding
GOOGLE_MAPS_API_KEY=replace_me

# MySQL (opcional — chat/admin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lyra_db

CALL_SESSION_TTL_SEC=7200
