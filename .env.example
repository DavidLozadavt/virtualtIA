# ── Lyra Microservice Configuration ──

# MySQL (XAMPP local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lyra_db

# LLM Model
MODEL_PATH=models/Mistral-7B-Instruct-v0.3-Q4_K_M.gguf
MODEL_N_CTX=4096
MODEL_N_GPU_LAYERS=-1
MODEL_N_THREADS=8

# Server
HOST=0.0.0.0
PORT=8000

# Rentus backend (for tool calls)
RENTUS_API_BASE=http://localhost/backend-rentus/public/api

# Google Maps API (para geocodificación — requerido en producción)
GOOGLE_MAPS_API_KEY=

# ── Twilio Speech Recognition (reconocimiento de voz) ──
# Modelo STT. Default deepgram_nova-2: maneja mucho mejor el audio PSTN degradado
# (µ-law 8kHz, ruido de línea, eco) y el español LATAM que googlev2.
# Alternativas: googlev2 (soporta es-CO; usar si se revierte), phone_call
#   (telefónico, usar TWILIO_SPEECH_LANGUAGE=es-US), experimental_conversations.
TWILIO_SPEECH_MODEL=deepgram_nova-2
# Idioma para googlev2/phone_call (NO aplica a deepgram, ver abajo):
TWILIO_SPEECH_LANGUAGE=es-CO
# Idioma para los modelos Deepgram. nova-2/nova-3 SOLO aceptan "es" o "es-419"
# (NO es-CO). es-419 = español LATAM, mejor match para acento payanés/caucano.
TWILIO_DEEPGRAM_LANGUAGE=es-419
# enhanced solo aplica a phone_call:
TWILIO_SPEECH_ENHANCED=true
# Fin-de-habla. "auto" = Twilio decide (no corta pausas naturales del dictado
# de direcciones). Para sí/no se usa el valor SHORT (numérico, ágil).
TWILIO_SPEECH_TIMEOUT_LONG=auto
TWILIO_SPEECH_TIMEOUT_SHORT=1.5
# partialResultCallback: DESACTIVADO por defecto. Cada turno dispara ~15-20
# callbacks con trabajo CPU síncrono que satura el event loop y "pausa" otras
# llamadas concurrentes. Hoy es funcionalmente inerte (barge-in real no
# implementado). Reactivar solo si se implementa barge-in vía Twilio REST.
TWILIO_ENABLE_PARTIAL=false

# ── FreeSWITCH / telefonía directa (Entel → FS → Lyra) ──
INTELLITAXI_API_BASE=http://127.0.0.1:8000/api
STT_PROVIDER=openai
TELEPHONY_STT_PROVIDER=openai
TELEPHONY_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_API_KEY=
# ── Modelo externo: APAGADO por defecto ──
# Lyra funciona entera con lo que tiene aquí: la capa de comprensión, el
# catálogo leído de la base de datos y sus propias respuestas. No hace ninguna
# llamada de red para conversar, buscar o agendar, así que no hay saldo que se
# agote ni servicio de terceros del que dependa.
#
# Ponlo en true sólo si quieres que un modelo externo AYUDE (redactar respuestas
# más libres, resolver necesidades que el catálogo no reconoce). Aun encendido
# es opcional: si falla, Lyra responde igual con lo suyo.
LLM_EXTERNAL_ENABLED=false

# ── Proveedor LLM (usado sólo si LLM_EXTERNAL_ENABLED=true) ──
# LLM_PROVIDER selecciona credencial y endpoint:
#   openrouter -> usa OPENROUTER_API_KEY (sk-or-...) contra https://openrouter.ai/api/v1
#   openai     -> usa OPENAI_API_KEY (sk-... / sk-proj-...) contra https://api.openai.com/v1
# OpenRouter y OpenAI son proveedores distintos con sistemas de keys distintos:
# usar la key equivocada da 401 "Missing Authentication header".
LLM_PROVIDER=openrouter
OPENAI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
# OPENAI_API_KEY se usa para chat solo si LLM_PROVIDER=openai. También para STT:
# si OPENAI_STT_API_KEY está vacío, el STT telefónico reutiliza OPENAI_API_KEY
# (el STT necesita una key de OpenAI directo, NUNCA una sk-or de OpenRouter).
OPENAI_API_KEY=
GROQ_API_KEY=
TELEPHONY_STT_LANGUAGE=es
TELEPHONY_WS_AUDIO_ENCODING=pcm16
TELEPHONY_AUDIO_CODEC=PCMU
TELEPHONY_SAMPLE_RATE=8000
LYRA_TTS_VOICE=es-BO-SofiaNeural
FREESWITCH_HTTP_BASE_URL=http://127.0.0.1:8098
FREESWITCH_WS_AUDIO_URL=ws://127.0.0.1:8098/freeswitch/audio
FREESWITCH_TTS_CACHE_DIR=data/freeswitch_tts
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon
FREESWITCH_ESL_ENABLED=true
VOICE_SESSION_STORE=redis
REDIS_URL=redis://127.0.0.1:6379/0
CALL_SESSION_TTL_SEC=7200